#!/bin/bash

set -euo pipefail

plugin_root="$(cd "$(dirname "$0")/.." && pwd)"
bridge="$plugin_root/bin/whoop-bridge"
state="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-whoop/latest.json"
action="${1:-detail}"

case "$action" in
  detail)
    if [[ -s "$state" ]]; then
      cat "$state"
    else
      printf '{"connected":false,"status":"Connect WHOOP"}\n'
    fi
    ;;
  sync)
    if "$bridge" status | jq -e '.authorized == true' >/dev/null; then
      "$bridge" sync >/dev/null
    fi
    ;;
  open)
    exec uwsm-app -- xdg-open "https://app.whoop.com/"
    ;;
  setup)
    exec uwsm-app -- xdg-terminal-exec "$plugin_root/setup"
    ;;
  status)
    exec "$bridge" status
    ;;
  *)
    printf 'Usage: whoop-widget {detail|sync|open|setup|status}\n' >&2
    exit 2
    ;;
esac
